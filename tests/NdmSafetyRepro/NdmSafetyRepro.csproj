<Project Sdk="Microsoft.NET.Sdk">

  <!-- P0 B1/B2 (NDM ↔ Food Log): kiểm tra các thao tác sửa/xoá ngày KHÔNG làm mất dữ liệu Food Log, trên LocalDB TẠM (MacroOS_NdmRepro: tạo mới rồi xoá trong chính lần chạy), KHÔNG DB dùng chung, không API.
       Chạy từ BE bằng dotnet run với project tests/NdmSafetyRepro, cấu hình Release. Thoát mã 1 nếu có kiểm tra FAIL. NEWOPS = các lệnh tách riêng mới (Remove Override, Fasting, Incomplete); bỏ định nghĩa để chạy trên bản cũ (fail-before). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>NU1902;NU1903</NoWarn>
    <DefineConstants>$(DefineConstants);NEWOPS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\API\API.csproj" />
    <ProjectReference Include="..\..\src\Application\Application.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\Infrastructure.csproj" />
  </ItemGroup>

</Project>
