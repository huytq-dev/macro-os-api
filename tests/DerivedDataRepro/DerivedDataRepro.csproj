<Project Sdk="Microsoft.NET.Sdk">

  <!-- Kiểm tra dựng lại dữ liệu dẫn xuất trên LocalDB TẠM (MacroOS_DerivedRepro: tạo mới rồi xoá trong chính lần chạy), KHÔNG DB dùng chung, không API. Chạy từ BE bằng dotnet run với project tests/DerivedDataRepro, cấu hình Release. Thoát mã 1 nếu có kiểm tra FAIL. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>NU1902;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\API\API.csproj" />
    <ProjectReference Include="..\..\src\Application\Application.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\Infrastructure.csproj" />
  </ItemGroup>

</Project>
