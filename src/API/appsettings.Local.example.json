{
  "ConnectionStrings": {
    "DefaultConnection": "Server=<host>;Database=<db>;User Id=<user>;Password=<password>;TrustServerCertificate=True;"
  },
  "Upstash": {
    "BaseUrl": "https://<name>.upstash.io",
    "Token": "<upstash-rest-token>"
  },
  "Jwt": {
    "SecretKey": "<chuỗi ngẫu nhiên >= 32 ký tự>"
  },
  "EmailSettings": {
    "SenderEmail": "<gmail>",
    "AppPassword": "<gmail-app-password>"
  },
  "Cloudinary": {
    "CloudName": "<cloud-name>",
    "ApiKey": "<api-key>",
    "ApiSecret": "<api-secret>"
  }
}
