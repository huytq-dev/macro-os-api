{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Application": {
    "PerformanceThresholdMs": 1000
  },
  "AllowedOrigins": [
    "http://localhost:3000",
    "https://fevent.vercel.app"
  ],
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Upstash": {
    "BaseUrl": "",
    "Token": ""
  },
  "Jwt": {
    "SecretKey": "",
    "Issuer": "https://fevent.runasp.net",
    "Audience": "User",
    "AccessTokenExpirationMinutes": 240,
    "RefreshTokenExpirationDays": 14
  },
  "EmailSettings": {
    "SenderEmail": "",
    "SenderName": "MacroOS",
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "AppPassword": ""
  },
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": ""
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "HttpStatusCode": 429,
    "QuotaExceededResponse": {
      "Content": "{{\"isSuccess\":false,\"statusCode\":429,\"message\":\"Too many requests. Please try again later.\",\"data\":null}}",
      "ContentType": "application/json",
      "StatusCode": 429
    },
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 120
      }
    ]
  },
  "Algorithm": {
    "KcalPerKg": 7700,
    "TrendDays": 20,
    "ExpenditureWindowDays": 21,
    "CalibratingDays": 14,
    "MaxWeeklyDeltaKcal": 150,
    "SmoothingBeta": 0.1
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Quartz": "Warning"
      }
    }
  }
}
